# Template for a project built from an Out of Tokens idea. Put this in your own
# repository as CITATION.cff and replace every value. The `references` entry is
# what credits the idea's authors in a form that tools can read.
cff-version: 1.2.0
message: "If you use this software, please cite it as below."
title: "Your project name"
authors:
  - family-names: "Your family name"
    given-names: "Your given name"
date-released: 2027-01-31
references:
  - type: generic
    title: "Title of the idea"
    authors:
      - name: "Idea author, exactly as on the idea page"
    year: 2026
    url: "https://<site URL>/ideas/OOT-0000/"
    notes: "Out of Tokens idea OOT-0000. This project is built from this idea."
